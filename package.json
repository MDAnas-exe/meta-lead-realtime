{
  "name": "meta-lead-realtime",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "concurrently \"npm run start:server\" \"npm run start:app\" \"npm run start:tunnel\"",
    "start:server": "npm --prefix backend start",
    "start:app": "npm --prefix frontend start",
    "start:tunnel": "npx ngrok http 3000",
    "dev": "concurrently \"npm run start:server\" \"npm run start:app\"",
    "tunnel": "npx ngrok http 3000"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "ngrok": "^5.0.0-beta.2"
  }
}